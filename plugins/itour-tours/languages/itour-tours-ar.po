#: src/Editor.php:238
msgid "Deposit"
msgstr "العربون"

#: src/Editor.php:249
msgid "0 = customers pay the full price at checkout. Otherwise they may pay this share now and the rest before travel."
msgstr "0 = يدفع العملاء السعر كاملًا عند الدفع. وإلا يمكنهم دفع هذه النسبة الآن والباقي قبل السفر."

