#. Plugin Name of the plugin
#: itour-documents.php
msgid "iTour Travel Documents"
msgstr "iTour Travel Documents"

#. Plugin URI of the plugin
#: itour-documents.php
msgid "https://github.com/mg-gouda/iTourTMSWP"
msgstr ""

#. Description of the plugin
#: itour-documents.php
msgid "PDF travel documents: a Travel Voucher for the guest (attached to the order emails and linked from My account), a Service Order for drivers and suppliers (no guest prices, cash to collect), and a Booking Report for any date range with totals per currency. Covers excursion and transfer bookings."
msgstr "مستندات سفر PDF: قسيمة سفر للضيف (مرفقة برسائل الطلب ومتاحة من حسابي)، وأمر خدمة للسائقين والموردين (بدون أسعار الضيف، مع المبلغ المطلوب تحصيله)، وتقرير حجوزات لأي فترة مع الإجماليات لكل عملة. يشمل حجوزات الرحلات والتنقلات."

#. Author of the plugin
#: itour-documents.php
msgid "Mohamed Gouda"
msgstr ""

