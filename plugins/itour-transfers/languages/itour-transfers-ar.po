msgid "Order"
msgstr "الترتيب"

#: src/Module.php:162
msgid "Lower numbers show first."
msgstr "الأرقام الأصغر تظهر أولًا."

#: src/Module.php:182
msgid "price"
msgstr "سعر"

#: src/Module.php:186
msgid "No prices yet. Set up zones under Location Tree and vehicles under Transfer vehicles, then add a price per route and vehicle. A price works both ways unless you add the return route separately."
msgstr "لا توجد أسعار بعد. جهّز المناطق في شجرة المواقع والمركبات في مركبات التنقل، ثم أضف سعرًا لكل مسار ومركبة. السعر يسري في الاتجاهين ما لم تضف مسار العودة بشكل منفصل."

#: src/Module.php:188
#: src/Module.php:201
msgid "From zone"
msgstr "من منطقة"

#: src/Module.php:189
#: src/Module.php:208
msgid "To zone"
msgstr "إلى منطقة"

#: src/Module.php:191
#: src/Module.php:222
msgid "Price per vehicle"
msgstr "السعر لكل مركبة"

#: src/Module.php:196
msgid "This route already has a price for this vehicle."
msgstr "هذا المسار له سعر بالفعل لهذه المركبة."

#: src/Module.php:225
msgid "One way, in your base currency (iTour → Company)."
msgstr "اتجاه واحد، بعملتك الأساسية (iTour ← الشركة)."

#: src/Module.php:294
msgid "See prices"
msgstr "اعرض الأسعار"

#: src/Module.php:299
msgid "From"
msgstr "من"

#: src/Module.php:301
msgid "Airport, hotel or city"
msgstr "مطار أو فندق أو مدينة"

#: src/Module.php:307
msgid "To"
msgstr "إلى"

#: src/Module.php:309
msgid "Hotel or address"
msgstr "فندق أو عنوان"

#: src/Module.php:315
msgid "Pick-up date"
msgstr "تاريخ الاستقبال"

#: src/Module.php:341
msgid "Pages used by Transfers. Prices, vehicles and booking rules are under the iTour menu."
msgstr "الصفحات التي تستخدمها التنقلات. الأسعار والمركبات وقواعد الحجز في قائمة iTour."

#: src/Module.php:345
msgid "Transfers page"
msgstr "صفحة التنقلات"

#: src/Module.php:348
msgid "The page that explains and books transfers."
msgstr "الصفحة التي تشرح خدمة التنقلات وتتيح حجزها."

#: src/Module.php:351
msgid "Search results page"
msgstr "صفحة نتائج البحث"

#: src/Module.php:354
msgid "Where the booking widget sends transfer searches. Put the “Transfer results” block on it. Leave empty to use the transfers page."
msgstr "الصفحة التي ترسل إليها أداة الحجز عمليات البحث عن التنقلات. ضع عليها كتلة «نتائج التنقلات». اتركها فارغة لاستخدام صفحة التنقلات."

#: src/Settings.php:33
msgid "Book at least (hours before pick-up)"
msgstr "الحجز قبل الاستقبال بـ (ساعات) على الأقل"

#: src/Settings.php:39
msgid "Flight number"
msgstr "رقم الرحلة"

#: src/Settings.php:41
msgid "Required for airport pick-ups"
msgstr "مطلوب للاستقبال من المطار"

#: src/Settings.php:46
msgid "Free waiting at airports (minutes)"
msgstr "الانتظار المجاني في المطارات (دقائق)"

#: src/Settings.php:49
msgid "Shown to the customer."
msgstr "يظهر للعميل."

#: src/Settings.php:53
msgid "Free waiting at hotels (minutes)"
msgstr "الانتظار المجاني في الفنادق (دقائق)"

#: src/Settings.php:59
msgid "Child seat, each"
msgstr "مقعد طفل، للواحد"

#: src/Settings.php:62
msgid "0 = free. Per seat, per trip, in your base currency."
msgstr "0 = مجاني. لكل مقعد ولكل رحلة، بعملتك الأساسية."

#: src/Settings.php:66
msgid "Extra bag, each"
msgstr "حقيبة إضافية، للواحدة"

#: src/Settings.php:69
msgid "For bags above the vehicle’s limit. Per bag, per trip."
msgstr "للحقائب الزائدة عن حد المركبة. لكل حقيبة ولكل رحلة."

#: src/Settings.php:73
msgid "Return trip discount (%)"
msgstr "خصم رحلة العودة (%)"

#: src/Settings.php:76
msgid "Taken off the return leg when both ways are booked together."
msgstr "يُخصم من رحلة العودة عند حجز الاتجاهين معًا."

#: src/Settings.php:111
msgid "Can’t be negative."
msgstr "لا يمكن أن تكون سالبة."

#: src/Settings.php:115
msgid "At most 100%."
msgstr "100% كحد أقصى."

#: src/Settings.php:131
msgid "Saved."
msgstr "تم الحفظ."

#: src/Settings.php:134
msgid "Please fix the highlighted fields."
msgstr "يرجى تصحيح الحقول المحددة."

#: src/Settings.php:143
msgid "Save"
msgstr "حفظ"

