#. Description of the plugin
#: itour-transfers.php
msgid "Private airport and city transfers: zones, vehicles, prices and booking, then dispatch, drivers and fleet."
msgstr "تنقلات خاصة من المطار وداخل المدن: المناطق والمركبات والأسعار والحجز، ثم التشغيل والسائقون والأسطول."

#. Author of the plugin
#: itour-transfers.php
msgid "Mohamed Gouda"
msgstr ""

#. Author URI of the plugin
#: itour-transfers.php
msgid "https://wa.me/+201002805139"
msgstr ""

#. translators: %s: place name(s) as typed.
#: blocks/transfer-results/render.php:35
#, php-format
msgid "We couldn’t find “%s” in our list. Pick one of the suggestions while typing, or contact us for a price."
msgstr "لم نجد «%s» في قائمتنا. اختر أحد الاقتراحات أثناء الكتابة، أو تواصل معنا لمعرفة السعر."

#: blocks/transfer-results/render.php:37
msgid "We don’t have a fixed price for this route and group size yet. Contact us and we’ll quote it."
msgstr "ليس لدينا سعر ثابت لهذا المسار وحجم المجموعة بعد. تواصل معنا وسنرسل لك عرض سعر."

#. translators: 1: from place, 2: to place, 3: number of passengers.
#: blocks/transfer-results/render.php:45
#, php-format
msgid "%1$s → %2$s, %3$d passenger"
msgid_plural "%1$s → %2$s, %3$d passengers"
msgstr[0] "%1$s ← %2$s، %3$d راكب"
msgstr[1] "%1$s ← %2$s، راكب واحد"
msgstr[2] "%1$s ← %2$s، راكبان"
msgstr[3] "%1$s ← %2$s، %3$d ركاب"
msgstr[4] "%1$s ← %2$s، %3$d راكبًا"
msgstr[5] "%1$s ← %2$s، %3$d راكب"

#. translators: 1: passengers, 2: bags.
#: blocks/transfer-results/render.php:52
#, php-format
msgid "Up to %1$d passengers · %2$d bags"
msgstr "حتى %1$d ركاب · %2$d حقائب"

#: blocks/transfer-results/render.php:53
msgid "One way"
msgstr "اتجاه واحد"

#: blocks/transfer-results/render.php:54
msgid "Return"
msgstr "ذهاب وعودة"

#. translators: 1: minutes at airports, 2: minutes at hotels.
#: blocks/transfer-results/render.php:58
#, php-format
msgid "Price per vehicle, not per person. Free waiting: %1$d minutes at airports, %2$d minutes at hotels."
msgstr "السعر لكل مركبة لا لكل شخص. الانتظار المجاني: %1$d دقيقة في المطارات، و%2$d دقيقة في الفنادق."

