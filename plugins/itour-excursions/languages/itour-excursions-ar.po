#: src/Sheet.php:55
msgid "0 = no limit."
msgstr "0 = بلا حد."

#: src/Sheet.php:56
msgid "One per line: From | To (To empty for a single day)."
msgstr "واحد في كل سطر: من | إلى (إلى فارغ ليوم واحد)."

#: src/Sheet.php:57
msgid "Comma separated: hotel (hotels in the zones), typed (customer types the hotel), meeting (meeting point)."
msgstr "مفصولة بفواصل: hotel (فنادق المناطق)، typed (يكتب العميل الفندق)، meeting (نقطة الالتقاء)."

#: src/Sheet.php:58
msgid "One per line: Zone (Location Tree name) | Pick-up time | Extra per person."
msgstr "واحدة في كل سطر: المنطقة (اسم من شجرة المواقع) | وقت الاستقبال | إضافي للفرد."

#: src/Sheet.php:59
msgid "Shown to customers who choose it."
msgstr "يظهر للعملاء الذين يختارونها."

#: src/Sheet.php:60
msgid "One price row per line: Type (shared or private) | Season from | Season to | From travellers | To travellers | Adult | Child | Infant. Season empty = all year; To travellers empty = no limit."
msgstr "صف سعر في كل سطر: النوع (shared أو private) | الموسم من | الموسم إلى | من عدد مسافرين | إلى عدد مسافرين | بالغ | طفل | رضيع. الموسم فارغ = العام كله؛ «إلى» فارغ = بلا حد."

#: src/Sheet.php:61
msgid "One per line: Name | Price | person or booking."
msgstr "واحد في كل سطر: الاسم | السعر | person أو booking."

#: src/Sheet.php:62
msgid "One per line: Name | Date | Until (optional) | Adult | Child | Infant."
msgstr "واحد في كل سطر: الاسم | التاريخ | حتى (اختياري) | بالغ | طفل | رضيع."

#. translators: %s: name.
#: src/Sheet.php:198
#, php-format
msgid "Destination “%s” isn’t in Location Tree."
msgstr "الوجهة «%s» غير موجودة في شجرة المواقع."

#: src/Sheet.php:202
msgid "Runs on: use day names like Mon, Wed, Fri, or any."
msgstr "أيام التشغيل: استخدم أسماء أيام مثل Mon, Wed, Fri أو any."

#. translators: %s: value.
#: src/Sheet.php:209
#, php-format
msgid "Start times: “%s” isn’t a time like 04:00."
msgstr "أوقات البدء: «%s» ليس وقتًا مثل 04:00."

#: src/Sheet.php:215
msgid "Pick-up: use hotel, typed and/or meeting."
msgstr "الاستقبال: استخدم hotel و/أو typed و/أو meeting."

#. translators: %s: column.
#: src/Sheet.php:220
#, php-format
msgid "%s must be a whole number."
msgstr "%s يجب أن يكون عددًا صحيحًا."
