<?xml version="1.0"?>
<ruleset name="iTourTMSWP">
	<description>WordPress Coding Standards for the iTour theme and plugins.</description>

	<file>plugins</file>
	<file>theme</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- The brand is spelled "iTour", so doc comments may start with a lower-case i. -->
		<exclude name="Generic.Commenting.DocComment.ShortNotCapital"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Classes live in PSR-4 paths (src/Foo/Bar.php), not class-foo-bar.php. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/src/*</exclude-pattern>
	</rule>

	<!-- Hook names use a slash namespace: itour/{module}/{event}. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="itour"/>
				<element value="itour-core"/>
				<element value="itour-crm"/>
				<element value="itour-traffic"/>
				<element value="itour-contracting"/>
				<element value="itour-reservations"/>
				<element value="itour-nile-cruises"/>
				<element value="itour-tour-ops"/>
				<element value="itour-b2b"/>
				<element value="itour-b2c"/>
				<element value="itour-finance"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="itour"/>
				<element value="ITour"/>
			</property>
		</properties>
	</rule>
</ruleset>
