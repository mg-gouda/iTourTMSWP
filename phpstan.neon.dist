parameters:
	level: 6
	paths:
		- plugins
		- theme
	excludePaths:
		- */vendor/*
		- */languages/*
		- plugins/itour-languages/*
		- plugins/itour-social/*
	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
	bootstrapFiles:
		- tools/phpstan-bootstrap.php
	ignoreErrors:
		# mPDF lives in the plugin's own vendor/ (composer install; not in git), so CI cannot see it.
		-
			identifier: class.notFound
			path: plugins/itour-documents/src/Pdf.php
