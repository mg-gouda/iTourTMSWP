#: inc/manual.php:22
msgid "Getting started"
msgstr ""

#: inc/manual.php:26
msgid "Requirements"
msgstr ""

#: inc/manual.php:28
msgid "WordPress 6.5 or newer (tested up to 7.1)."
msgstr ""

#: inc/manual.php:28
msgid "PHP 8.1 or newer."
msgstr ""

#: inc/manual.php:28
msgid "No other plugins are required. The theme works on its own."
msgstr ""

#: inc/manual.php:33
msgid "Install and activate"
msgstr ""

#: inc/manual.php:38
msgid "In the dashboard go to Appearance → Themes → Add New Theme → Upload Theme."
msgstr ""

#: inc/manual.php:39
msgid "Choose wp-itourtms.zip and click Install Now."
msgstr ""

#: inc/manual.php:40
msgid "Click Activate."
msgstr ""

#: inc/manual.php:41
msgid "To change templates or styles safely, also install wp-itourtms-child.zip and activate the child theme instead (see “Child theme” below)."
msgstr ""

#: inc/manual.php:48
msgid "First setup (10 minutes)"
msgstr ""

#: inc/manual.php:50
msgid "Right after activation, Appearance → Theme Options opens on “Quick setup”: pick a design, add your logo and contact details, and create the main menu from your pages. It shows until you finish or skip it. The steps below do the rest by hand."
msgstr ""

#: inc/manual.php:54
msgid "Logo: Appearance → Customize → Site Identity → Select logo. A transparent PNG or SVG about 200 × 48 px works best."
msgstr ""

#: inc/manual.php:55
msgid "Menus: Appearance → Menus. Create a menu, add pages, then tick “Main menu” (header) or “Footer menu” under Menu Settings."
msgstr ""

#: inc/manual.php:56
msgid "Home page: Settings → Reading → “A static page”, then choose your Homepage and Posts page."
msgstr ""

#: inc/manual.php:57
msgid "Pretty links: Settings → Permalinks → “Post name” → Save."
msgstr ""

#: inc/manual.php:58
msgid "Language: Settings → General → Site Language. Arabic and other right-to-left languages flip the layout automatically."
msgstr ""

#: inc/manual.php:59
msgid "Your brand: Appearance → Theme Options → Options. Set your colours, widths, header and footer (see “Theme Options” in the User manual)."
msgstr ""

#: inc/manual.php:66
msgid "Child theme"
msgstr ""

#: inc/manual.php:68
msgid "Updates replace the theme’s files. Put your own changes in the WP iTourTMS Child theme (included in the package) so they survive updates. Activate the child theme; it loads the parent automatically."
msgstr ""

#: inc/manual.php:74
msgid "User manual"
msgstr ""

#: inc/manual.php:78
msgid "Create and edit pages"
msgstr ""

#: inc/manual.php:80
msgid "Pages are built with the WordPress block editor. No page builder is needed. Ready-made sections (hero banner, reasons to book, call to action) are under + → Patterns → “WP iTourTMS”."
msgstr ""

#: inc/manual.php:84
msgid "Go to Pages → Add New Page and type a title."
msgstr ""

#: inc/manual.php:85
msgid "Click + (top left) to add a block: Paragraph, Heading, Image, Columns, Buttons, Cover and so on. Type / in an empty line to search blocks quickly."
msgstr ""

#: inc/manual.php:86
msgid "Select a block to change its colour, spacing or width in the right-hand panel. The theme’s colours appear as swatches."
msgstr ""

#: inc/manual.php:87
msgid "Use “Wide width” or “Full width” on Image, Cover and Group blocks for banners and galleries."
msgstr ""

#: inc/manual.php:88
msgid "Click Publish (or Update). Use Preview first to check it on the site."
msgstr ""

#: inc/manual.php:97
msgid "Appearance → Theme Options → Options holds every theme setting. Click “Save options” to apply them to the site and the block editor together."
msgstr ""

#: inc/manual.php:101
msgid "Design: six complete looks (Nile Classic, Desert Dusk, Red Sea, Midnight Gold, Oasis, iTourTMS). Clicking one fills in colours, fonts, shapes, header, top bar, footer and booking-widget style; change anything, then save."
msgstr ""

#: inc/manual.php:102
msgid "Colours: brand, hover, text, secondary text, soft background and page background. A warning appears if a pair is hard to read."
msgstr ""

#: inc/manual.php:103
msgid "Logo: site logo, retina logo (twice the size, for sharp high-resolution screens), mobile logo and a light logo for dark headers, plus display heights. SVG, WebP, PNG and JPG are accepted; SVG files are cleaned of scripts when uploaded."
msgstr ""

#: inc/manual.php:104
msgid "Fonts: pick any Google Font for body text and headings (type to search), the base text size and heading weight. The preview shows the result before you save. Leave empty for the fast system font."
msgstr ""

#: inc/manual.php:105
msgid "Layout: text column width, wide width (header, footer, wide blocks) and corner rounding."
msgstr ""

#: inc/manual.php:106
msgid "Module tabs: each iTourTMS plugin you install adds its own tab here, for example to choose the pages it uses."
msgstr ""

#: inc/manual.php:107
msgid "Header: four designs (classic, centred, over the hero, floating), colours, an optional button, a sticky header and the account link. With a logo, the site title is hidden."
msgstr ""

#: inc/manual.php:108
msgid "Top bar: switch on “Show top bar” to reveal its settings: four designs (split, centred, minimal, announcement), a short message and link, whether to show contact details and social links, its colours, and whether it shows on phones (as icons)."
msgstr ""

#: inc/manual.php:109
msgid "Contact & social: phone, email, WhatsApp, address and social links (Facebook, Instagram, X, TikTok, YouTube, LinkedIn), entered once and used by the top bar and the footer. Empty fields are left out."
msgstr ""

#: inc/manual.php:110
msgid "Footer → Layout: no columns, 3 columns or 4 columns. For each column choose what it shows: About (logo and text), a Menu, Contact details, Social links, your own Text, Widgets, or nothing, and give it a title. Only the settings for the chosen type appear. Footer colours and the bottom line ({year} and {site} are filled in for you) are at the end."
msgstr ""

#: inc/manual.php:111
msgid "Blog: show dates, show the featured image on posts, and the length of summaries in lists."
msgstr ""

#: inc/manual.php:114
msgid "“Reset to defaults” puts every option back to the theme’s original values."
msgstr ""

#: inc/manual.php:119
msgid "Colours and fonts for the whole site"
msgstr ""

#: inc/manual.php:121
msgid "Appearance → Design → Styles changes the colours, fonts and button style everywhere at once, and the change shows in the editor too. Appearance → Fonts adds or removes font families. To undo, open Styles → ⋮ → Reset."
msgstr ""

#: inc/manual.php:122
msgid "Keep text readable: dark text on light backgrounds (or the reverse) with strong contrast."
msgstr ""

#: inc/manual.php:127
msgid "Images"
msgstr ""

#: inc/manual.php:129
msgid "Upload photos at least 1600 px wide for full-width banners; WordPress makes the smaller sizes for you."
msgstr ""

#: inc/manual.php:129
msgid "Always fill in “Alternative text” to describe the photo for screen readers and search engines."
msgstr ""

#: inc/manual.php:129
msgid "Featured image (right-hand panel on posts and pages) is the picture shown in blog lists and when the page is shared."
msgstr ""

#: inc/manual.php:134
msgid "Blog posts"
msgstr ""

#: inc/manual.php:136
msgid "Posts → Add New Post. Give each post a featured image and a category. Posts appear on the page chosen as “Posts page” under Settings → Reading. To keep one post at the top, tick “Stick to the top of the blog” in the post settings."
msgstr ""

#: inc/manual.php:141
msgid "Menus"
msgstr ""

#: inc/manual.php:143
msgid "Appearance → Menus. Drag items to reorder them; drag an item slightly right to make it a drop-down under the item above. The header shows two levels; the footer shows one."
msgstr ""

#: inc/manual.php:148
msgid "Comments"
msgstr ""

#: inc/manual.php:150
msgid "Turn comments on or off for the whole site under Settings → Discussion, or per post in the post settings. Approve or delete them under Comments."
msgstr ""

#: inc/manual.php:155
msgid "Getting help"
msgstr ""

#: inc/manual.php:157
msgid "Check this manual and the Documentation tab first. For support, contact the author through the Author URI in the theme details (Appearance → Themes → WP iTourTMS → Theme Details)."
msgstr ""

#: inc/manual.php:163
msgid "Documentation"
msgstr ""

#: inc/manual.php:167
msgid "Theme files"
msgstr ""

#: inc/manual.php:174
msgid "Colours, fonts and spacing"
msgstr ""

#: inc/manual.php:176
msgid "All design values live in theme.json and become CSS custom properties such as --wp--preset--color--brand. Change them in a child theme’s theme.json and both the editor and the site update; you don’t need to edit CSS."
msgstr ""

#: inc/manual.php:178
msgid "Keep at least 4.5:1 contrast between text and its background. The default palette meets WCAG 2.2 AA."
msgstr ""

#: inc/manual.php:183
msgid "Overriding templates"
msgstr ""

#: inc/manual.php:185
msgid "Copy any template or template part into the child theme at the same path and edit the copy. For example, to change how posts look in lists, copy template-parts/content-summary.php."
msgstr ""

#: inc/manual.php:190
msgid "Hooks for developers"
msgstr ""

#: inc/manual.php:192
msgid "wp_itourtms_manual (filter): add tabs or sections to this manual, e.g. from a plugin."
msgstr ""

#: inc/manual.php:192
msgid "wp_itourtms_option_sections (filter): add a vertical tab to Theme Options → Options. Give the section its own “store” option name so its settings stay with your plugin. Field types: color, px, number, checkbox, text, select, font, page."
msgstr ""

#: inc/manual.php:192
msgid "wp_itourtms_options( $store ) returns the saved values with defaults."
msgstr ""

#: inc/manual.php:192
msgid "Standard WordPress hooks: wp_head, wp_body_open, wp_footer, and the_content."
msgstr ""

#: inc/manual.php:199
msgid "Translation and right-to-left"
msgstr ""

#: inc/manual.php:201
msgid "Every string uses the wp-itourtms text domain. Translate languages/wp-itourtms.pot with Poedit or Loco Translate and save wp-itourtms-{locale}.mo in wp-content/languages/themes/. Layout uses CSS logical properties, so right-to-left languages need no extra stylesheet."
msgstr ""

#: inc/manual.php:206
msgid "Accessibility"
msgstr ""

#: inc/manual.php:208
msgid "Skip link to the main content as the first focusable element."
msgstr ""

#: inc/manual.php:208
msgid "Visible focus outline on every link, button and form field."
msgstr ""

#: inc/manual.php:208
msgid "Menus work with the keyboard; drop-downs open on focus."
msgstr ""

#: inc/manual.php:208
msgid "Animations are switched off when the visitor prefers reduced motion."
msgstr ""

#: inc/manual.php:213
msgid "Privacy"
msgstr ""

#: inc/manual.php:215
msgid "The theme stores no personal data, sets no cookies and does no tracking. With the default system font it loads nothing from other servers. If you choose a Google Font, visitors’ browsers load it from Google’s servers (fonts.googleapis.com and fonts.gstatic.com); mention this in your privacy policy."
msgstr ""

#: inc/manual.php:220
msgid "Credits and license"
msgstr ""

#: inc/manual.php:222
msgid "WP iTourTMS © 2026 Mohamed Gouda, licensed under the GNU GPL v2 or later. The theme uses no third-party code, fonts or images; the system font stack is used."
msgstr ""

