{
	"name": "mg-gouda/itourtmswp",
	"description": "iTourTMS for WordPress: the iTour theme, iTour Core and one plugin per iTourTMS module.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"authors": [
		{ "name": "Mohamed Gouda", "homepage": "https://wa.me/+201002805139" }
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"php-stubs/woocommerce-stubs": "^11.2",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": { "php": "8.1.0" },
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"check": [ "@lint", "@analyse" ]
	}
}
